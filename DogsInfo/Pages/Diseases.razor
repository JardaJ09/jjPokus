@page "/diseases"
@using DogsInfo.Models
@using DogsInfo.Shared

<PageTitle>Dog Diseases</PageTitle>

<h1 class="page-header">Common Dog Diseases</h1>

<p class="lead mb-4">Learn about common diseases that affect dogs, their symptoms, and recommended actions.</p>

<div class="accordion disease-accordion" id="diseaseAccordion">
    @foreach (var disease in diseases)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading@(disease.Id)">
                <button class="accordion-button collapsed" type="button" 
                        data-bs-toggle="collapse" data-bs-target="#collapse@(disease.Id)" 
                        aria-expanded="false" aria-controls="collapse@(disease.Id)">
                    <span class="me-3">@disease.Name</span>
                    <SeverityBadge Severity="@disease.Severity" />
                </button>
            </h2>
            <div id="collapse@(disease.Id)" class="accordion-collapse collapse" 
                 aria-labelledby="heading@(disease.Id)" data-bs-parent="#diseaseAccordion">
                <div class="accordion-body">
                    <section aria-label="Disease description">
                        <h3 class="h6 fw-bold">Description</h3>
                        <p>@disease.Description</p>
                    </section>
                    
                    <section aria-label="Disease symptoms">
                        <h3 class="h6 fw-bold">Symptoms</h3>
                        <p>@disease.Symptoms</p>
                    </section>
                    
                    <section aria-label="Suggested actions">
                        <h3 class="h6 fw-bold">Suggested Actions</h3>
                        <p class="mb-0">@disease.SuggestedActions</p>
                    </section>
                </div>
            </div>
        </div>
    }
</div>

