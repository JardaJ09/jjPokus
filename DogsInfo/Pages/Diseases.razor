@page "/diseases"
@using DogsInfo.Models
@using DogsInfo.Components

<PageTitle>Dog Diseases</PageTitle>

<h1>Common Dog Diseases</h1>

<p class="lead mb-4">Learn about common health issues that can affect dogs. Click on each disease to see more details.</p>

<div class="accordion" id="diseasesAccordion">
    @foreach (var (disease, index) in diseases.Select((d, i) => (d, i)))
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading@(index)">
                <button class="accordion-button @(index != 0 ? "collapsed" : "")" type="button" 
                        data-bs-toggle="collapse" data-bs-target="#collapse@(index)" 
                        aria-expanded="@(index == 0 ? "true" : "false")" aria-controls="collapse@(index)">
                    <span class="me-3">@disease.Name</span>
                    <SeverityBadge Severity="@disease.Severity" />
                </button>
            </h2>
            <div id="collapse@(index)" class="accordion-collapse collapse @(index == 0 ? "show" : "")" 
                 aria-labelledby="heading@(index)" data-bs-parent="#diseasesAccordion">
                <div class="accordion-body">
                    <h5>Description</h5>
                    <p>@disease.Description</p>
                    
                    <h5>Symptoms</h5>
                    <p>@disease.Symptoms</p>
                    
                    <h5>Suggested Action</h5>
                    <p class="mb-0">
                        <span class="badge bg-primary">@disease.SuggestedAction</span>
                    </p>
                </div>
            </div>
        </div>
    }
</div>

