@page "/"

<PageTitle>DogsInfo - Home</PageTitle>

<div class="text-center py-4">
    <h1 class="display-4">Welcome to DogsInfo</h1>
    <p class="lead">Your comprehensive guide to dog breeds, health, and care.</p>
    <hr class="my-4" />
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title h4">🐕 Dog Breeds</h2>
                <p class="card-text">
                    Explore popular dog breeds from around the world. Learn about their origins, 
                    size categories, and temperaments. Use our search and filter features to find 
                    the perfect breed for you.
                </p>
                <a href="breeds" class="btn btn-primary">View Breeds</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title h4">🏥 Dog Diseases</h2>
                <p class="card-text">
                    Stay informed about common diseases that can affect your furry friend. 
                    Learn about symptoms, severity levels, and recommended actions to keep 
                    your dog healthy and happy.
                </p>
                <a href="diseases" class="btn btn-primary">View Diseases</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="card-title h4">🤚 How to Pet Dogs</h2>
                <p class="card-text">
                    Learn the proper techniques for petting dogs safely. Discover the best 
                    spots to pet, areas to avoid, and how to read a dog's body language 
                    for a positive interaction.
                </p>
                <a href="petting" class="btn btn-primary">Learn How to Pet</a>
            </div>
        </div>
    </div>
</div>

<div class="mt-5">
    <h2 class="h4">About This App</h2>
    <p>
        DogsInfo is a .NET 8 Blazor WebAssembly application designed to provide helpful information 
        about dog breeds, common canine health issues, and proper dog care techniques. All data is 
        stored in-memory and can be easily customized to suit your needs.
    </p>
</div>
