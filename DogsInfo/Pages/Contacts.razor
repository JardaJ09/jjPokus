@page "/contacts"

<PageTitle>Contacts - DogsInfo</PageTitle>

<h1 class="page-header">Contact Us</h1>

<p class="lead mb-4">Get in touch with our team of dog experts. We're here to help!</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var contact in contacts)
    {
        <div class="col">
            <div class="card h-100 contact-card">
                <div class="card-body text-center">
                    <div class="contact-avatar mb-3">
                        <div class="avatar-circle" style="background-color: @contact.AvatarColor">
                            @contact.Initials
                        </div>
                    </div>
                    <h5 class="card-title mb-1">@contact.Name</h5>
                    <p class="text-muted small mb-3">@contact.Role</p>
                    <div class="contact-info">
                        <p class="mb-2">
                            <span class="contact-icon">📧</span>
                            <a href="mailto:@contact.Email">@contact.Email</a>
                        </p>
                        <p class="mb-2">
                            <span class="contact-icon">📱</span>
                            <a href="tel:@contact.Phone">@contact.Phone</a>
                        </p>
                        <p class="mb-0">
                            <span class="contact-icon">📍</span>
                            @contact.Location
                        </p>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <span class="badge bg-primary rounded-pill">@contact.Specialty</span>
                </div>
            </div>
        </div>
    }
</div>

<div class="card mt-5">
    <div class="card-header bg-primary text-white">
        <h2 class="h5 mb-0">📬 General Inquiries</h2>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h6>Office Address</h6>
                <p class="text-muted">
                    DogsInfo Headquarters<br>
                    123 Paw Street, Suite 456<br>
                    Pet City, CA 90210<br>
                    United States
                </p>
            </div>
            <div class="col-md-6">
                <h6>Business Hours</h6>
                <p class="text-muted">
                    Monday - Friday: 9:00 AM - 6:00 PM<br>
                    Saturday: 10:00 AM - 4:00 PM<br>
                    Sunday: Closed
                </p>
            </div>
        </div>
    </div>
</div>

