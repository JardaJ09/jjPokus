@page "/breeds"
@using DogsInfo.Models

<PageTitle>Dog Breeds</PageTitle>

<h1>Dog Breeds</h1>

<div class="mb-4">
    <div class="row g-3">
        <div class="col-md-6">
            <label for="searchBox" class="form-label">Search by name:</label>
            <input type="text" id="searchBox" class="form-control" placeholder="Enter breed name..." @bind="searchTerm" @bind:event="oninput" />
        </div>
        <div class="col-md-6">
            <label for="sizeFilter" class="form-label">Filter by size:</label>
            <select id="sizeFilter" class="form-select" @bind="selectedSize">
                <option value="">All Sizes</option>
                <option value="Small">Small</option>
                <option value="Medium">Medium</option>
                <option value="Large">Large</option>
            </select>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var breed in FilteredBreeds)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@breed.ImageUrl" class="card-img-top" alt="@breed.Name" style="height: 200px; object-fit: cover;" />
                <div class="card-body">
                    <h5 class="card-title">@breed.Name</h5>
                    <p class="card-text">
                        <strong>Origin:</strong> @breed.Origin<br />
                        <strong>Size:</strong> <span class="badge bg-info text-dark">@breed.SizeCategory</span><br />
                        <strong>Temperament:</strong> @breed.Temperament
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@if (!FilteredBreeds.Any())
{
    <div class="alert alert-info mt-4" role="alert">
        No breeds found matching your criteria.
    </div>
}

